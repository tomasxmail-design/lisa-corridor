      <dl>
        <dt>Internal no.</dt><dd>46555702</dd>
        <dt>Authored in</dt><dd>SolidWorks 2022</dd>
        <dt>File date</dt><dd>2024-05-08</dd>
        <dt>Size</dt><dd>1.12 MB</dd>
      </dl>
      <a class="dl" href="step_work/productImages/ 75T1550_46555702.step" download>Download .step</a>
    </div>

    <div class="card">
      <span class="badge">STEP AP214</span>
      <h2>973A0500.01</h2>
      <dl>
        <dt>Internal no.</dt><dd>44552976</dd>
        <dt>Authored in</dt><dd>SolidWorks 2022</dd>
        <dt>File date</dt><dd>2024-05-07</dd>
        <dt>Size</dt><dd>444 KB</dd>
      </dl>
      <a class="dl" href="step_work/productImages/973A0500.01_44552976.step" download>Download .step</a>
    </div>

    <div class="card">
      <span class="badge">STEP AP214</span>
      <h2>173H7100</h2>
      <dl>
        <dt>Internal no.</dt><dd>44226109</dd>
        <dt>Authored in</dt><dd>SolidWorks 2025</dd>
        <dt>File date</dt><dd>2025-09-01</dd>
        <dt>Size</dt><dd>352 KB</dd>
      </dl>
      <a class="dl" href="step_work/productImages/173H7100_44226109.step" download>Download .step</a>
    </div>
  </div>

  <footer>
    Note: this page lists the model files and lets you download them — it does not render the 3D geometry in-browser
    (that requires a CAD viewing engine such as the one used by ShareCAD.org or 3dviewer.net, where you can drag
    these .step files in directly to inspect them in 3D).
  </footer>
</body>
</html>
